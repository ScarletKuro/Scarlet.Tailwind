<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Enable Tailwind runtime download mode: no Scarlet.Tailwind.Runtime.* package is referenced, and the
         binary is fetched once and cached under TailwindRuntimeDirectory. -->
    <TailwindRuntimeDownload>true</TailwindRuntimeDownload>
    <TailwindVersionDownload>4.3.3</TailwindVersionDownload>
    <TailwindRuntimeDirectory>$(MSBuildProjectDirectory)/runtimes</TailwindRuntimeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used when dotnet watch rebuilds the project, such as with Hot Reload disabled.
         Hot Reload still observes @(Watch) items, but observing a change does not invoke
         TailwindCompile, so use the long-running Tailwind CLI watcher in that mode. -->
    <Watch Include="Styles\**\*.css;**\*.razor;**\*.razor.cs;**\*.cshtml;**\*.html;wwwroot\**\*.js" />
  </ItemGroup>

  <!-- Import the Tailwind targets from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Tailwind.MSBuild\Scarlet.Tailwind.MSBuild.targets" />

  <ItemGroup>
    <!-- Exercises the non-default settings the other sample leaves alone: minified output and an external
         source map, which is the form that produces a second generated file. -->
    <TailwindBeforeStaticWebAssets Include="Styles\app.css">
      <OutputPath>wwwroot\css\app.css</OutputPath>
      <Minify>true</Minify>
      <Map>wwwroot\css\app.css.map</Map>
    </TailwindBeforeStaticWebAssets>
  </ItemGroup>

  <Target Name="VerifyTailwindOutput" AfterTargets="RunTailwindBeforeStaticWebAssets">
    <Error Text="CSS output was not created." Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\app.css')" />
    <Error Text="External source map was not created." Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\app.css.map')" />
    <Message Text="Tailwind download build completed successfully." Importance="high" />
  </Target>

</Project>
