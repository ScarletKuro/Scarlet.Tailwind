<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used when dotnet watch rebuilds the project, such as with Hot Reload disabled.
         Hot Reload still observes @(Watch) items, but observing a change does not invoke
         TailwindCompile, so use the long-running Tailwind CLI watcher in that mode. -->
    <Watch Include="Styles\**\*.css;**\*.razor;**\*.razor.cs;**\*.cshtml;**\*.html;wwwroot\**\*.js" />
  </ItemGroup>

  <!-- Import the Tailwind targets from the referenced project (development scenario) -->
  <Import Project="..\..\src\Scarlet.Tailwind.MSBuild\Scarlet.Tailwind.MSBuild.targets" />

  <ItemGroup>
    <TailwindBeforeStaticWebAssets Include="Styles\app.css">
      <OutputPath>wwwroot\css\app.css</OutputPath>
    </TailwindBeforeStaticWebAssets>
  </ItemGroup>

  <Target Name="VerifyTailwindOutput" AfterTargets="RunTailwindBeforeStaticWebAssets">
    <Error Text="CSS output was not created." Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\css\app.css')" />
    <Message Text="Tailwind build completed successfully." Importance="high" />
  </Target>

</Project>
