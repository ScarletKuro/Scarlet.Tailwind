<Project>
  <!-- Development copy, imported directly by the samples and integration tests. It is deliberately NOT
       packed: it points at bin/ rather than at the package's tools/ folder, and it adds the ProjectReference
       that builds the task in the first place. Everything below the UsingTask must stay byte-identical to
       build/Scarlet.Tailwind.MSBuild.targets apart from the one documented DependsOnTargets difference -
       TailwindTargetsTests asserts exactly that, so a change here without the matching change there fails
       the build. -->
  <PropertyGroup>
    <_TailwindTaskProjectDir>$(MSBuildThisFileDirectory)</_TailwindTaskProjectDir>
    <_TailwindTaskAssembly>$(_TailwindTaskProjectDir)bin\$(Configuration)\netstandard2.0\Scarlet.Tailwind.MSBuild.dll</_TailwindTaskAssembly>
    <TailwindRuntimeDirectory Condition="'$(TailwindRuntimeDirectory)' == ''">$(_TailwindTaskProjectDir)bin\runtimes</TailwindRuntimeDirectory>
    <TailwindEnabled Condition="'$(TailwindEnabled)' == ''">true</TailwindEnabled>
    <TailwindMinify Condition="'$(TailwindMinify)' == ''">Auto</TailwindMinify>
    <TailwindOptimize Condition="'$(TailwindOptimize)' == ''">false</TailwindOptimize>
    <TailwindMap Condition="'$(TailwindMap)' == ''">Auto</TailwindMap>
    <TailwindSilent Condition="'$(TailwindSilent)' == ''">false</TailwindSilent>
    <TailwindDownloadMutexTimeoutSeconds Condition="'$(TailwindDownloadMutexTimeoutSeconds)' == ''">300</TailwindDownloadMutexTimeoutSeconds>
    <TailwindTimeoutMilliseconds Condition="'$(TailwindTimeoutMilliseconds)' == ''">0</TailwindTimeoutMilliseconds>
  </PropertyGroup>

  <!-- TaskHostFactory runs the task out of process, so the built DLL is not locked by the MSBuild node and
       can be rebuilt without restarting it. Only worth the process launch in a development loop. -->
  <UsingTask TaskName="Scarlet.Tailwind.MSBuild.TailwindCompileTask"
             AssemblyFile="$(_TailwindTaskAssembly)"
             TaskFactory="TaskHostFactory" />

  <ItemGroup>
    <ProjectReference Include="$(_TailwindTaskProjectDir)Scarlet.Tailwind.MSBuild.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="_TailwindResolveManifestDirectory">
    <PropertyGroup>
      <_TailwindManifestDirectory Condition="'$(TailwindManifestDirectory)' != ''">$(TailwindManifestDirectory)</_TailwindManifestDirectory>
      <_TailwindManifestDirectory Condition="'$(_TailwindManifestDirectory)' == '' AND '$(IntermediateOutputPath)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Scarlet.Tailwind'))))</_TailwindManifestDirectory>
    </PropertyGroup>
  </Target>

  <!-- The one allowed difference from the packed copy: ResolveProjectReferences has to run first, because
       the task assembly this imports is produced by the ProjectReference above rather than restored from a
       package. -->
  <Target Name="RunTailwindBeforeStaticWebAssets"
          BeforeTargets="DispatchToInnerBuilds;ResolveProjectStaticWebAssets;PreBuildEvent"
          DependsOnTargets="ResolveProjectReferences;_TailwindResolveManifestDirectory"
          Returns="@(_TailwindContentChanges)"
          Condition="'$(TailwindEnabled)' == 'true' AND '@(TailwindBeforeStaticWebAssets)' != '' AND '$(DesignTimeBuild)' != 'true' AND '$(NoBuild)' != 'true' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' == '')">
    <TailwindCompileTask Compilations="@(TailwindBeforeStaticWebAssets)"
                         ProjectDirectory="$(MSBuildProjectDirectory)"
                         Configuration="$(Configuration)"
                         Minify="$(TailwindMinify)"
                         Optimize="$(TailwindOptimize)"
                         Map="$(TailwindMap)"
                         Silent="$(TailwindSilent)"
                         Cwd="$(TailwindCwd)"
                         AdditionalArguments="$(TailwindAdditionalArguments)"
                         ManifestDirectory="$(_TailwindManifestDirectory)"
                         RuntimeDirectory="$(TailwindRuntimeDirectory)"
                         TailwindRuntimeDownload="$(TailwindRuntimeDownload)"
                         TailwindVersionDownload="$(TailwindVersionDownload)"
                         DownloadMutexTimeoutSeconds="$(TailwindDownloadMutexTimeoutSeconds)"
                         TimeoutMilliseconds="$(TailwindTimeoutMilliseconds)"
                         ConfigurationOnly="false"
                         RuntimePacks="@(TailwindRuntimePack)">
      <Output TaskParameter="GeneratedFiles" ItemName="_TailwindGeneratedFiles" />
      <Output TaskParameter="RemovedFiles" ItemName="_TailwindRemovedFiles" />
      <Output TaskParameter="WatchInvocations" ItemName="_TailwindWatchInvocations" />
    </TailwindCompileTask>

    <!-- The task reports removed files as absolute paths, but the SDK's wwwroot glob holds them project-relative,
         and Remove inside a target matches item specs rather than resolved paths. Without the relative form the
         glob's stale entry survives, and the static web assets SDK fails the build on a file that is gone. -->
    <ItemGroup>
      <_TailwindRemovedContent Include="$([MSBuild]::MakeRelative($([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)')), '%(_TailwindRemovedFiles.FullPath)'))"
                               Condition="'@(_TailwindRemovedFiles)' != ''" />
      <Content Remove="@(_TailwindRemovedFiles);@(_TailwindRemovedContent)" />
      <None Remove="@(_TailwindRemovedFiles);@(_TailwindRemovedContent)" />
      <_TailwindGeneratedContent Include="%(_TailwindGeneratedFiles.RelativePath)" />
      <_TailwindNewContent Include="@(_TailwindGeneratedContent)" Exclude="@(Content)" />
      <Content Include="@(_TailwindNewContent)" CopyToPublishDirectory="PreserveNewest" />
      <FileWrites Include="@(_TailwindGeneratedFiles)" />
      <_TailwindContentChanges Include="@(_TailwindGeneratedContent)" Change="Generated" />
      <_TailwindContentChanges Include="@(_TailwindRemovedContent)" Change="Removed" />
    </ItemGroup>
  </Target>

  <!-- An inner build is not always reached through this project's own outer build. A ProjectReference from an
       app builds the referenced framework directly (dotnet run on the app never builds this project's outer
       build), and so does dotnet build -f. Neither would ever compile. And a rebuild's Clean phase evaluates and
       caches the inner builds before anything is compiled, so even when the outer build compiles first, Content
       it registers there never reaches them.

       So every inner build asks the outer build to compile, and applies what that compilation changed to its
       own items. MSBuild runs a target once per project instance and hands every later caller its cached
       Returns, so this compiles nothing when the outer build already compiled before dispatching, and compiles
       exactly once when it did not, however many frameworks or referencing apps ask. Removing TargetFramework
       is what addresses the outer instance: it is the only global property the outer build adds when it
       dispatches.

       Removed files matter as much as generated ones. This build evaluated its wwwroot glob before the
       compilation deleted stale outputs, and the static web assets SDK fails on an asset whose file is gone.

       No FileWrites here: the outer build owns these files, and an inner build's incremental clean would
       otherwise delete outputs it believes are its own. TailwindClean removes them from the manifest instead.

       A caller that reaches this project with different global properties (a ProjectReference with
       AdditionalProperties, say) addresses a different outer instance, which compiles again. TailwindCompileTask
       makes those compilations take turns.

       The DesignTimeBuild guard is not what keeps the IDE from compiling: that global property reaches the outer
       instance through this call, where RunTailwindBeforeStaticWebAssets already skips. It saves evaluating the
       outer project on every design-time build. -->
  <Target Name="_TailwindCompileFromInnerBuild"
          BeforeTargets="ResolveProjectStaticWebAssets;PreBuildEvent"
          Condition="'$(TailwindEnabled)' == 'true' AND '@(TailwindBeforeStaticWebAssets)' != '' AND '$(DesignTimeBuild)' != 'true' AND '$(NoBuild)' != 'true' AND '$(TargetFrameworks)' != '' AND '$(TargetFramework)' != ''">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="RunTailwindBeforeStaticWebAssets"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_TailwindOuterContentChanges" />
    </MSBuild>

    <ItemGroup>
      <_TailwindOuterRemovedFiles Include="@(_TailwindOuterContentChanges)" Condition="'%(_TailwindOuterContentChanges.Change)' == 'Removed'" />
      <_TailwindOuterGeneratedContent Include="@(_TailwindOuterContentChanges)" Condition="'%(_TailwindOuterContentChanges.Change)' == 'Generated'" />
      <Content Remove="@(_TailwindOuterRemovedFiles)" />
      <None Remove="@(_TailwindOuterRemovedFiles)" />
      <_TailwindOuterNewContent Include="@(_TailwindOuterGeneratedContent)" Exclude="@(Content)" />
      <Content Include="%(_TailwindOuterNewContent.Identity)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="_TailwindResolveWatchConfiguration"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(TailwindEnabled)' == 'true' AND '@(TailwindBeforeStaticWebAssets)' != '' AND ('$(TargetFrameworks)' == '' OR '$(TargetFramework)' == '')">
    <TailwindCompileTask Compilations="@(TailwindBeforeStaticWebAssets)"
                         ProjectDirectory="$(MSBuildProjectDirectory)"
                         Configuration="$(Configuration)"
                         Minify="$(TailwindMinify)"
                         Optimize="$(TailwindOptimize)"
                         Map="$(TailwindMap)"
                         Silent="$(TailwindSilent)"
                         Cwd="$(TailwindCwd)"
                         AdditionalArguments="$(TailwindAdditionalArguments)"
                         ManifestDirectory="$(TailwindManifestDirectory)"
                         RuntimeDirectory="$(TailwindRuntimeDirectory)"
                         TailwindRuntimeDownload="$(TailwindRuntimeDownload)"
                         TailwindVersionDownload="$(TailwindVersionDownload)"
                         DownloadMutexTimeoutSeconds="$(TailwindDownloadMutexTimeoutSeconds)"
                         TimeoutMilliseconds="$(TailwindTimeoutMilliseconds)"
                         ConfigurationOnly="true"
                         RuntimePacks="@(TailwindRuntimePack)">
      <Output TaskParameter="GeneratedFiles" ItemName="_TailwindWatchGeneratedFiles" />
      <Output TaskParameter="RemovedFiles" ItemName="_TailwindWatchRemovedFiles" />
      <Output TaskParameter="WatchInvocations" ItemName="_TailwindWatchInvocations" />
    </TailwindCompileTask>
  </Target>

  <!-- Explicitly queried by `dotnet tailwind watch`. Keeping the public target unconditional means a
       disabled or unconfigured project succeeds with an empty result instead of returning MSBuild's
       "Skipped" result. The conditional helper above does the real resolution without compiling. -->
  <Target Name="ResolveTailwindWatchConfiguration"
          DependsOnTargets="_TailwindResolveWatchConfiguration"
          Returns="@(_TailwindWatchInvocations)" />

  <!-- Hooked to both targets deliberately. In a single-target-framework project CoreClean runs with
       $(IntermediateOutputPath) set to obj/<config>/<tfm>/, which is where the build wrote the manifest. In
       a multi-targeted one CoreClean only runs in the inner builds, whose obj/<config>/<tfm>/ never held a
       manifest - the build ran once in the outer build and wrote to obj/<config>/. Clean does run in the
       outer build, so hooking it as well is what makes `dotnet clean` remove generated CSS from a
       multi-targeted project. Whichever hook resolves the other directory finds no manifest and deletes
       nothing, so running twice is harmless. -->
  <Target Name="TailwindClean"
          BeforeTargets="CoreClean;Clean"
          DependsOnTargets="_TailwindResolveManifestDirectory">
    <ReadLinesFromFile File="$(_TailwindManifestDirectory)/Tailwind.generated.txt"
                       Condition="'$(_TailwindManifestDirectory)' != '' AND Exists('$(_TailwindManifestDirectory)/Tailwind.generated.txt')">
      <Output TaskParameter="Lines" ItemName="_TailwindFilesToClean" />
    </ReadLinesFromFile>
    <Delete Files="@(_TailwindFilesToClean)" Condition="'@(_TailwindFilesToClean)' != ''" />
    <Delete Files="$(_TailwindManifestDirectory)/Tailwind.generated.txt;$(_TailwindManifestDirectory)/Tailwind.removed.txt"
            Condition="'$(_TailwindManifestDirectory)' != ''" />
  </Target>
</Project>
